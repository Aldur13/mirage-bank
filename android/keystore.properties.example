# Copy to keystore.properties (gitignored) and fill in real values.
# Generate the keystore once with:
#   keytool -genkeypair -v -keystore mirage-release.jks -keyalg RSA -keysize 2048 -validity 10000 -alias mirage-release
# Store mirage-release.jks OUTSIDE this repo (password manager / CI secret).
# Losing this keystore permanently breaks the update chain for every
# existing install — there is no recovery path, so back it up carefully.
storeFile=/absolute/path/to/mirage-release.jks
storePassword=changeme
keyAlias=mirage-release
keyPassword=changeme
